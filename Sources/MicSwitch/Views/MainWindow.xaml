<Window x:Class="MicSwitch.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:c="clr-namespace:MicSwitch.Controls"
        xmlns:vm="clr-namespace:MicSwitch.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{Binding Title}"
        Icon="{Binding CurrentIcon}"
        Width="760" Height="860" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="StatusBadge" TargetType="Border">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="56" />
            <Setter Property="CornerRadius" Value="28" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMuted}" Value="{x:Null}">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDisabledBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
            <Setter Property="Text" Value="&#xE720;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter Property="Text" Value="&#xEC54;" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="820" Margin="24,16,24,24">

            <!-- Status -->
            <Border Style="{StaticResource Card}" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StatusBadge}">
                        <TextBlock Style="{StaticResource StatusGlyph}" FontSize="26" Foreground="White" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding MicrophoneStatus}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MicrophoneStatusDetail}" Style="{StaticResource SecondaryText}" FontSize="13" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{DynamicResource AccentButtonStyle}" MinWidth="120" Padding="16,8"
                            Content="{Binding ToggleMuteText}" Command="{Binding ToggleMuteCommand}"
                            IsEnabled="{Binding IsMicrophoneConnected}" />
                </Grid>
            </Border>

            <!-- Notices -->
            <Border Style="{StaticResource InfoBar}" Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Margin="0,0,12,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="MicSwitch isn't running as administrator. Hotkeys won't work while an elevated app or game is focused." />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding UpdateVersion, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Content="Restart and update" Command="{Binding InstallUpdateCommand}" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE895;" Margin="0,0,12,0" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                        <Run Text="MicSwitch" /> <Run Text="{Binding UpdateVersion, Mode=OneWay}" /> <Run Text="is available." />
                    </TextBlock>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="{StaticResource IconFont}" Padding="8"
                            Command="{Binding DismissStatusCommand}" AutomationProperties.Name="Dismiss" />
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Microphone -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Microphone" />
            <c:SettingRow Glyph="&#xE720;" Header="Device" Description="Which microphone the hotkeys control">
                <ComboBox MinWidth="260" ItemsSource="{Binding Microphones}" DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectedValue="{Binding SelectedMicrophoneId}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE765;" Header="Mode" Description="{Binding SelectedItem.Description, ElementName=ModeBox}">
                <ComboBox x:Name="ModeBox" MinWidth="200" ItemsSource="{Binding MuteModes}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding MuteMode}" />
            </c:SettingRow>
            <ContentControl Content="{Binding MainHotkey}" ContentTemplate="{StaticResource HotkeyRowTemplate}" Focusable="False" />
            <c:SettingRow Glyph="&#xE7E8;" Header="State at startup" Description="Applies in Toggle mode" IsEnabled="{Binding IsToggleMode}">
                <ComboBox MinWidth="200" ItemsSource="{Binding InitialStates}" DisplayMemberPath="Name" SelectedValuePath="Value"
                          SelectedValue="{Binding InitialState}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE767;" Header="Set microphone volume" Description="Re-applies this input level at startup and when devices change">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="180" Minimum="0" Maximum="100" Value="{Binding MicrophoneVolume}" VerticalAlignment="Center"
                            IsEnabled="{Binding MicrophoneVolumeControlEnabled}" AutomationProperties.Name="Microphone volume" />
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding MicrophoneVolume, StringFormat={}{0:0}%}" />
                    <CheckBox Margin="16,0,0,0" IsChecked="{Binding MicrophoneVolumeControlEnabled}" AutomationProperties.Name="Set microphone volume" />
                </StackPanel>
            </c:SettingRow>

            <Expander Margin="0,0,0,4" HorizontalAlignment="Stretch" IsExpanded="{Binding AdvancedHotkeysEnabled, Mode=OneTime}">
                <Expander.Header>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding AdvancedHotkeysEnabled}" AutomationProperties.Name="Enable additional hotkeys" />
                        <StackPanel>
                            <TextBlock Text="Additional hotkeys" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Separate keys for toggle, mute, unmute, push-to-talk and push-to-mute" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding AdvancedHotkeys}" ItemTemplate="{StaticResource HotkeyRowTemplate}"
                              IsEnabled="{Binding AdvancedHotkeysEnabled}" Focusable="False" />
            </Expander>

            <!-- Sounds -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Sounds" />
            <c:SettingRow Glyph="&#xE74F;" Header="When muted">
                <StackPanel Orientation="Horizontal">
                    <ComboBox MinWidth="200" ItemsSource="{Binding SoundOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SoundWhenMuted}" />
                    <Button Margin="8,0,0,0" Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE768;" ToolTip="Preview"
                            Command="{Binding PlaySoundCommand}" CommandParameter="{Binding SoundWhenMuted}" AutomationProperties.Name="Preview muted sound" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE767;" Header="When live">
                <StackPanel Orientation="Horizontal">
                    <ComboBox MinWidth="200" ItemsSource="{Binding SoundOptions}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SoundWhenUnmuted}" />
                    <Button Margin="8,0,0,0" Padding="8" FontFamily="{StaticResource IconFont}" Content="&#xE768;" ToolTip="Preview"
                            Command="{Binding PlaySoundCommand}" CommandParameter="{Binding SoundWhenUnmuted}" AutomationProperties.Name="Preview live sound" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE995;" Header="Volume">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding NotificationVolume}" VerticalAlignment="Center" AutomationProperties.Name="Notification volume" />
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding NotificationVolume, StringFormat={}{0:0}%}" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE7F5;" Header="Play through">
                <ComboBox MinWidth="260" ItemsSource="{Binding PlaybackDevices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding PlaybackDeviceId}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE710;" Header="Custom sounds" Description="Add a WAV, MP3 or other audio file">
                <Button Content="Add sound…" Command="{Binding AddSoundCommand}" />
            </c:SettingRow>

            <!-- Overlay -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Overlay" />
            <c:SettingRow Glyph="&#xE7F4;" Header="Show overlay" Description="An always-on-top indicator of the microphone state">
                <ComboBox MinWidth="200" ItemsSource="{Binding OverlayVisibilityModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding OverlayVisibility}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE72E;" Header="Position" Description="Unlock to drag and resize the overlay; double-click it to lock again" IsEnabled="{Binding IsOverlayEnabled}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Reset" Command="{Binding ResetOverlayPositionCommand}" Margin="0,0,8,0" />
                    <ToggleButton MinWidth="100" IsChecked="{Binding IsOverlayLocked, Converter={x:Static c:InverseBool.Instance}}" Content="Unlocked" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE790;" Header="Opacity" IsEnabled="{Binding IsOverlayEnabled}">
                <StackPanel Orientation="Horizontal">
                    <Slider Width="200" Minimum="0.1" Maximum="1" SmallChange="0.05" LargeChange="0.1" Value="{Binding OverlayOpacity}" VerticalAlignment="Center" AutomationProperties.Name="Overlay opacity" />
                    <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding OverlayOpacity, StringFormat={}{0:P0}}" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xEB9F;" Header="Icons" Description="Click an icon to replace it. Also used for the tray icon.">
                <StackPanel Orientation="Horizontal">
                    <Button Padding="6" Command="{Binding SelectMutedIconCommand}" ToolTip="Muted icon" AutomationProperties.Name="Choose muted icon">
                        <Image Source="{Binding MutedIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <Button Padding="6" Margin="8,0" Command="{Binding SelectUnmutedIconCommand}" ToolTip="Live icon" AutomationProperties.Name="Choose live icon">
                        <Image Source="{Binding UnmutedIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Button>
                    <Button Content="Reset" Command="{Binding ResetIconsCommand}" />
                </StackPanel>
            </c:SettingRow>

            <!-- Speakers -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="Speakers" />
            <Expander Margin="0,0,0,4" HorizontalAlignment="Stretch" IsExpanded="{Binding SpeakerControlEnabled, Mode=OneTime}">
                <Expander.Header>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" IsChecked="{Binding SpeakerControlEnabled}" AutomationProperties.Name="Enable speaker hotkeys" />
                        <StackPanel>
                            <TextBlock Text="Speaker hotkeys" />
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Mute and change output volume with hotkeys; the overlay briefly shows the level" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <StackPanel IsEnabled="{Binding SpeakerControlEnabled}">
                    <c:SettingRow Glyph="&#xE7F5;" Header="Device">
                        <ComboBox MinWidth="260" ItemsSource="{Binding Speakers}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSpeakerId}" />
                    </c:SettingRow>
                    <c:SettingRow Glyph="&#xE767;" Header="Volume">
                        <StackPanel Orientation="Horizontal">
                            <Slider Width="200" Minimum="0" Maximum="100" Value="{Binding SpeakerVolume}" VerticalAlignment="Center" AutomationProperties.Name="Speaker volume" />
                            <TextBlock Width="44" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding SpeakerVolume, StringFormat={}{0:0}%}" />
                        </StackPanel>
                    </c:SettingRow>
                    <ItemsControl ItemsSource="{Binding SpeakerHotkeys}" ItemTemplate="{StaticResource HotkeyRowTemplate}" Focusable="False" />
                </StackPanel>
            </Expander>

            <!-- General -->
            <TextBlock Style="{StaticResource SectionHeader}" Text="General" />
            <c:SettingRow Glyph="&#xE790;" Header="Theme">
                <ComboBox MinWidth="200" ItemsSource="{Binding Themes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE7E8;" Header="Start with Windows">
                <CheckBox IsChecked="{Binding RunAtStartup}" AutomationProperties.Name="Start with Windows" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE73F;" Header="Start minimized to the notification area">
                <CheckBox IsChecked="{Binding StartMinimized}" AutomationProperties.Name="Start minimized" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE8BB;" Header="Closing the window keeps MicSwitch running" Description="Exit from the notification area icon">
                <CheckBox IsChecked="{Binding MinimizeOnClose}" AutomationProperties.Name="Keep running when closed" />
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE895;" Header="Check for updates at startup">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" Margin="0,0,16,0" />
                    <CheckBox IsChecked="{Binding CheckForUpdates}" AutomationProperties.Name="Check for updates at startup" />
                </StackPanel>
            </c:SettingRow>
            <c:SettingRow Glyph="&#xE946;" Header="About" Description="{Binding VersionText}">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Open settings and logs folder" Command="{Binding OpenDataFolderCommand}" Margin="0,0,8,0" />
                    <Button Content="Project page" Command="{Binding OpenProjectPageCommand}" />
                </StackPanel>
            </c:SettingRow>
        </StackPanel>
    </ScrollViewer>
</Window>
