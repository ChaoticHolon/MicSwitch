<Project Sdk="Microsoft.NET.Sdk">
  <!-- Windows executable: wires the Avalonia UI (MicSwitch.UI) to the Windows platform services (MicSwitch.Windows). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\microphoneEnabled.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MicSwitch.UI\MicSwitch.UI.csproj" />
    <ProjectReference Include="..\MicSwitch.Windows\MicSwitch.Windows.csproj" />
  </ItemGroup>
</Project>
