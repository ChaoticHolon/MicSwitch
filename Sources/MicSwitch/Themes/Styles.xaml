<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MicSwitch.Controls">
    <!-- Fluent brushes are referenced with DynamicResource so light/dark switches apply live. -->
    <c:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <c:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="4,24,0,8" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="InfoBar" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="c:SettingRow">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingRow">
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="160" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Glyph}" Text="{TemplateBinding Glyph}" FontSize="20" Margin="0,0,16,0"
                                       Visibility="{TemplateBinding Glyph, Converter={StaticResource NotEmptyToVisibility}}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Description}" Style="{StaticResource SecondaryText}"
                                           Visibility="{TemplateBinding Description, Converter={StaticResource NotEmptyToVisibility}}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="HotkeyEditorTemplate">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <c:HotkeyBox Gesture="{Binding Key}" AutomationProperties.Name="{Binding Title}" />
                <TextBlock Text="or" Margin="8,0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" />
                <c:HotkeyBox Gesture="{Binding AlternativeKey}" AutomationProperties.Name="Alternative hotkey" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox Content="Block from other apps" IsChecked="{Binding Suppress}" Margin="0,0,16,0"
                          ToolTip="Other applications won't see this hotkey. May not work for every mouse button." />
                <CheckBox Content="Ignore Ctrl/Alt/Shift" IsChecked="{Binding IgnoreModifiers}"
                          IsEnabled="{Binding HasModifiers, Converter={x:Static c:InverseBool.Instance}}"
                          ToolTip="Trigger even while modifier keys are held" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="HotkeyRowTemplate">
        <c:SettingRow Header="{Binding Title}" Content="{Binding}" ContentTemplate="{StaticResource HotkeyEditorTemplate}" />
    </DataTemplate>
</ResourceDictionary>
