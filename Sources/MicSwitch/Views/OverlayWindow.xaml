<Window x:Class="MicSwitch.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MicSwitch.Controls"
        Title="MicSwitch overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        ResizeMode="NoResize" Width="96" Height="96" MinWidth="24" MinHeight="24" MaxWidth="400" MaxHeight="400"
        Opacity="{Binding OverlayOpacity}">
    <Grid x:Name="Root">
        <!-- Visible frame and drag surface only while unlocked. -->
        <Border CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                Background="#40000000" Cursor="SizeAll"
                Visibility="{Binding IsOverlayLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"
                ToolTip="Drag to move, drag the corner to resize, double-click to lock">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Lock overlay" Command="{Binding ToggleOverlayLockCommand}" />
                    <MenuItem Header="Reset position" Command="{Binding ResetOverlayPositionCommand}" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
        <Image Source="{Binding CurrentIcon}" Margin="6" Stretch="Uniform" IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="HighQuality"
               Visibility="{Binding ShowOutputIndicator, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
        <Viewbox Margin="8" IsHitTestVisible="False" Visibility="{Binding ShowOutputIndicator, Converter={StaticResource BoolToVisibility}}">
            <Border Background="#C0202020" CornerRadius="12" Padding="10,6">
                <StackPanel>
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding OutputIndicatorGlyph}" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OutputIndicatorText}" Foreground="White" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Viewbox>
        <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" x:Name="Grip"
                    Visibility="{Binding IsOverlayLocked, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
    </Grid>
</Window>
