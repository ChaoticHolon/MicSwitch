<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:MicSwitch.Controls"
        xmlns:vm="using:MicSwitch.ViewModels"
        x:Class="MicSwitch.Views.OverlayWindow"
        x:DataType="vm:MainViewModel"
        Title="MicControlNG overlay"
        WindowDecorations="None" Background="Transparent" TransparencyLevelHint="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" CanResize="False"
        SizeToContent="WidthAndHeight"
        Opacity="{Binding OverlayOpacity}">
    <c:OverlayBadge x:Name="Badge" Margin="4" Cursor="SizeAll"
                    ToolTip.Tip="Drag to move. Double-click to finish editing." />
</Window>
